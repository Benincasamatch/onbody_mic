{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnbodyMic",
  "version": "0.4.0",
  "identifier": "com.onbodymic.desktop",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build/start-desktop-dev.ps1",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build/build-desktop-assets.ps1",
    "devUrl": "http://127.0.0.1:1425",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "随声麦",
      "width": 1320,
      "height": 860,
      "minWidth": 760,
      "minHeight": 640,
      "decorations": false,
      "transparent": true,
      "theme": "Dark"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com;",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com http://127.0.0.1:1425 ws://127.0.0.1:1425;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/OnbodyMic.EngineHost"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
